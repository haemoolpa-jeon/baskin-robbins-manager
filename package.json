{
  "name": "baskin-robbins-manager",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @br/inventory",
    "dev:inventory": "npm run dev -w @br/inventory",
    "dev:workforce": "npm run dev -w @br/workforce",
    "demo": "npm run demo -w @br/inventory",
    "demo:workforce": "npm run demo -w @br/workforce",
    "build": "npm run build -w @br/inventory",
    "build:inventory": "npm run build -w @br/inventory",
    "build:workforce": "npm run build -w @br/workforce",
    "build:all": "npm run build -w @br/inventory && npm run build -w @br/workforce",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
